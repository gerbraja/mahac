# Variables de Entorno — Siigo / DIAN Facturación Electrónica
# Copia este archivo a .env y completa los valores reales de tu cuenta Siigo Nube

# ============================================================
# SIIGO API — Credenciales (obtenlas en app.siigo.com → API)
# ============================================================
SIIGO_USERNAME=tu_usuario@empresa.com
SIIGO_ACCESS_KEY=tu_access_key_de_siigo
SIIGO_PARTNER_ID=TEIPlatform

# ============================================================
# SIIGO — Configuración de Factura de Venta
# Para obtener estos IDs: GET /document-types en la API Siigo
# ============================================================
# ID del tipo de comprobante "Factura de Venta Electrónica" en Siigo Nube
SIIGO_DOCUMENT_ID=

# ID del vendedor (user) en Siigo Nube — GET /users en la API
# Recomendado: crear un usuario genérico llamado "Venta Web" en Siigo
SIIGO_SELLER_ID=

# (Opcional) ID del Centro de Costos — útil para separar ventas por canal en Siigo
# Si no lo usas, déjalo vacío
SIIGO_COST_CENTER=

# ============================================================
# SIIGO — URL Base de la API
# Sandbox (pruebas): https://api.siigo.com/       (o siigo-api-sandbox dependiendo del plan)
# Producción:        https://api.siigo.com/
# ============================================================
SIIGO_API_URL=https://api.siigo.com/

# ============================================================
# INFORMACIÓN DE LA EMPRESA EMISORA (Tu empresa)
# ============================================================
COMPANY_NIT=123456789
COMPANY_DV=0
COMPANY_NAME=Tu Empresa Internacional S.A.S
COMPANY_TAX_REGIME=No responsable de IVA
