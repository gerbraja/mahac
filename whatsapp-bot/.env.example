# Puerto del servidor
PORT=8080

# Configuración de WhatsApp Cloud API
WHATSAPP_TOKEN=tu_token_de_acceso_temporal_o_permanente
WHATSAPP_PHONE_NUMBER_ID=tu_identificador_de_numero_de_telefono
WHATSAPP_VERIFY_TOKEN=token_personalizado_para_handshake_del_webhook

# Configuración de Google Gemini API
GEMINI_API_KEY=tu_clave_api_de_google_ai_studio

# Configuración de Google Sheets API
GOOGLE_SHEET_ID=id_de_tu_hoja_de_calculo
GOOGLE_SERVICE_ACCOUNT_EMAIL=correo_de_tu_cuenta_de_servicio@proyecto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Configuración de Base de Datos (Ruta al archivo dev.db de la tienda virtual)
# En local se asume la ruta relativa subiendo un nivel
DATABASE_PATH=../dev.db
